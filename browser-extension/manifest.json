{
  "manifest_version": 3,
  "name": "Relay Desk Browser Companion",
  "version": "0.1.0",
  "description": "Capture selected Google and WhatsApp Web pages; apply explicitly reviewed Calendar moves through visible controls.",
  "key": "",
  "permissions": ["storage", "alarms", "downloads"],
  "optional_permissions": ["scripting"],
  "optional_host_permissions": ["https://ogs.google.com/*"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://calendar.google.com/*",
    "https://web.whatsapp.com/*",
    "http://127.0.0.1:43891/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Relay Desk" },
  "content_scripts": [{
    "matches": ["https://mail.google.com/*", "https://calendar.google.com/*", "https://web.whatsapp.com/*"],
    "js": ["whatsapp.js", "extractors.js", "calendar-actions.js", "mail-read.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false,
    "world": "ISOLATED"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:43891"
  }
}
