{
  "name": "relay-desk",
  "productName": "Relay Desk",
  "version": "0.1.0",
  "description": "A local-first communications workspace powered by your Copilot subscription.",
  "license": "Apache-2.0",
  "author": "Ai4Innov",
  "homepage": "https://github.com/Ai4Innov/relaydesk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ai4Innov/relaydesk.git"
  },
  "bugs": {
    "url": "https://github.com/Ai4Innov/relaydesk/issues"
  },
  "keywords": [
    "copilot",
    "electron",
    "email",
    "gmail",
    "slack",
    "local-first",
    "assistant"
  ],
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": "^24.13.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ci": "node scripts/test-batches.cjs",
    "test:e2e": "playwright test",
    "doctor": "node scripts/doctor.cjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "build": "vite build --config vite.renderer.config.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.14",
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "docx": "^9.11.0",
    "dompurify": "^3.4.15",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "1.63.0",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.1.2",
    "yauzl": "^3.2.0",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.100"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "42.11.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers@12.11.1": true,
    "electron@42.11.6": true,
    "esbuild@0.21.5": true,
    "koffi@3.3.1": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.6": true,
    "sharp@0.34.5": true,
    "tesseract.js@6.0.1": true
  }
